
FROM ghcr.io/acts-project/ubuntu2404:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHIA8_DIR=/workspaces/particle-tracking-research/pythia/pythia8318
ENV PATH="${PYTHIA8_DIR}/bin:${PATH}"

# System and scientific software dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    gfortran \
    cmake \
    ninja-build \
    ccache \
    git \
    curl \
    wget \
    ca-certificates \
    sudo \
    pkg-config \
    dpkg-dev \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    libhepmc3-dev \
    libssl-dev \
    libx11-dev \
    libxext-dev \
    libxft-dev \
    libxpm-dev \
    libxmu-dev \
    libglu1-mesa-dev \
    libgl1-mesa-dev \
    libglew-dev \
    libgif-dev \
    libtbb-dev \
    libvdt-dev \
    libboost-all-dev \
    libeigen3-dev \
    libxerces-c-dev \
    libxml2-dev \
    libexpat1-dev \
    libpcre2-dev \
    liblz4-dev \
    libzstd-dev \
    libfftw3-dev \
    libcfitsio-dev \
    libgsl-dev \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Configure ubuntu user
RUN id -u ubuntu >/dev/null 2>&1 || useradd -m -s /bin/bash ubuntu \
    && usermod -s /bin/bash ubuntu \
    && echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu \
    && chmod 0440 /etc/sudoers.d/ubuntu

WORKDIR /workspaces/particle-tracking-research

COPY requirements.txt /tmp/requirements.txt

RUN python3 -m pip install --no-cache-dir \
    --break-system-packages \
    -r /tmp/requirements.txt

# Development user
USER ubuntu

CMD ["bash"]
